generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client-mysql"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int                 @id @default(autoincrement())
  email               String              @unique @db.VarChar(200)
  password_hash       String              @db.VarChar(255)
  name                String?             @db.VarChar(200)
  role                String              @default("user") @db.VarChar(20)
  status              String              @default("pending") @db.VarChar(20)
  theme               String              @default("dark") @db.VarChar(10)
  avatar              Int?                @db.SmallInt
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt
  audit_logs          AuditLog[]
  user_mfa            UserMfa?
  passkey_credentials PasskeyCredential[]
  api_keys            ApiKey[]
  device_tokens       DeviceToken[]
  assigned_tasks      ReviewTask[]        @relation("UserAssignedTasks")
  task_activities     TaskActivity[]      @relation("UserTaskActivities")

  @@map("users")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  user_id     Int?
  user        User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  action      String   @db.VarChar(50)
  resource    String   @db.VarChar(100)
  resource_id String?  @db.VarChar(100)
  details     String?  @db.Text
  ip          String?  @db.VarChar(45)
  created_at  DateTime @default(now())

  @@map("audit_logs")
}

model FeatureFlag {
  key         String   @id @db.VarChar(50)
  enabled     Int      @default(1) @db.TinyInt
  label       String   @db.VarChar(100)
  description String   @db.VarChar(255)
  category    String   @default("system") @db.VarChar(50)

  @@map("feature_flags")
}

model Changelog {
  id          Int      @id @default(autoincrement())
  date        DateTime @db.Date
  description String   @db.Text
  created_at  DateTime @default(now())

  @@map("changelog")
}

model UserMfa {
  user_id      Int      @id
  secret       String   @db.VarChar(128)
  enabled      Int      @default(0) @db.TinyInt
  backup_codes String?  @db.Text
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_mfa")
}

model WatermarkConfig {
  id          Int      @id @default(1)
  enabled     Int      @default(0) @db.TinyInt
  custom_text String   @default("{{email}} • CONFIDENTIAL") @db.VarChar(255)
  show_qr     Int      @default(1) @db.TinyInt
  opacity     Int      @default(7)
  font_size   Int      @default(12)
  updated_at  DateTime @default(now()) @updatedAt

  @@map("watermark_config")
}

model RolePermission {
  role    String @db.VarChar(20)
  nav_key String @db.VarChar(50)

  @@id([role, nav_key])
  @@map("role_permissions")
}

model PasskeyCredential {
  id          String    @id @db.VarChar(255)
  user_id     Int
  public_key  String    @db.Text
  counter     BigInt    @default(0)
  device_type String    @default("singleDevice") @db.VarChar(64)
  backed_up   Int       @default(0) @db.TinyInt
  transports  String?   @db.VarChar(255)
  name        String    @default("Passkey") @db.VarChar(200)
  created_at  DateTime  @default(now())
  last_used   DateTime? @db.DateTime(0)
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("passkey_credentials")
}

model PasskeyChallenge {
  id         String   @id @db.VarChar(255)
  challenge  String   @db.VarChar(255)
  user_id    Int?
  expires_at DateTime @db.DateTime(0)
  created_at DateTime @default(now())

  @@map("passkey_challenges")
}

model ApiKey {
  id         Int       @id @default(autoincrement())
  key_hash   String    @db.VarChar(64)
  prefix     String    @unique @db.VarChar(12)
  name       String    @db.VarChar(200)
  contact    String    @db.VarChar(200)
  expires_at DateTime? @db.DateTime(0)
  created_by Int?
  user       User?     @relation(fields: [created_by], references: [id], onDelete: SetNull)
  created_at DateTime  @default(now())
  last_used  DateTime? @db.DateTime(0)
  active     Int       @default(1) @db.TinyInt

  @@index([created_by])
  @@map("api_keys")
}

model DeviceToken {
  id         Int       @id @default(autoincrement())
  user_id    Int
  token_hash String    @unique @db.VarChar(64)
  created_at DateTime  @default(now())
  last_used  DateTime? @db.DateTime(0)
  expires_at DateTime  @db.DateTime(0)
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("device_tokens")
}

model ObservabilityConfig {
  type           String   @id @db.VarChar(50)
  enabled        Int      @default(0) @db.TinyInt
  endpoint       String   @db.VarChar(255)
  api_key        String?  @db.VarChar(255)
  site_id        String?  @db.VarChar(100)
  log_level      String?  @default("info") @db.VarChar(20)
  custom_headers String?  @db.Text
  updated_at     DateTime @default(now()) @updatedAt

  @@map("observability_config")
}

model PixxelSyncConfig {
  id                  Int       @id @default(autoincrement())
  server_url          String    @default("http://192.168.100.228:3030") @db.VarChar(255)
  api_key             String?   @db.Text
  sync_source         String    @default("api") @db.VarChar(20)
  last_sync_at        DateTime?
  last_sync_status    String?   @db.VarChar(50)
  last_sync_message   String?   @db.Text
  assets_synced_count Int       @default(0)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  @@map("pixxel_sync_config")
}

model Pixxel360SyncConfig {
  id                    Int       @id @default(autoincrement())
  server_url            String    @default("http://192.168.100.228:7002") @db.VarChar(255)
  api_key               String?   @db.Text
  sync_source           String    @default("database") @db.VarChar(20)
  last_sync_at          DateTime?
  last_sync_status      String?   @db.VarChar(50)
  last_sync_message     String?   @db.Text
  controls_synced_count Int       @default(0)
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  @@map("pixxel360_sync_config")
}

model Application {
  id                 String   @id @db.VarChar(36)
  pixxel_asset_id    String?  @unique @db.VarChar(100)
  name               String   @db.VarChar(255)
  short_code         String?  @db.VarChar(50)
  category           String   @default("Application") @db.VarChar(100)
  type               String   @default("SaaS") @db.VarChar(50)
  lifecycle_status   String   @default("Production") @db.VarChar(50)
  description        String?  @db.Text
  business_owner     String?  @db.VarChar(255)
  technical_owner    String?  @db.VarChar(255)
  vendor             String?  @db.VarChar(255)
  app_url            String?  @db.VarChar(500)
  doc_url            String?  @db.VarChar(500)
  repo_url           String?  @db.VarChar(500)
  knowledge_base_url String?  @db.VarChar(500)
  regulatory_sources String?  @db.Text
  raw_sync_data      String?  @db.LongText
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  assessments        Assessment[]
  review_tasks       ReviewTask[]

  @@index([category])
  @@index([lifecycle_status])
  @@map("applications")
}

model Standard {
  id          String   @id @default(cuid()) @db.VarChar(36)
  category    String   @default("Security") @db.VarChar(50)
  title       String   @db.VarChar(200)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  content     String   @db.LongText
  source      String   @default("pixxel360") @db.VarChar(50)
  item_count  Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([category])
  @@map("standards")
}

model LlmProviderConfig {
  id               String    @id @db.VarChar(50) // "ollama", "antigravity", "codex", "claude"
  name             String    @db.VarChar(100)
  enabled          Int       @default(0) @db.TinyInt
  is_active        Int       @default(0) @db.TinyInt // 1 if primary default engine
  base_url         String?   @db.VarChar(500)
  api_key          String?   @db.Text
  default_model    String    @db.VarChar(100)
  available_models String?   @db.Text
  temperature      Float     @default(0.2)
  max_tokens       Int       @default(4096)
  timeout_seconds  Int       @default(60)
  last_test_at     DateTime?
  last_test_status String?   @db.VarChar(50)
  last_test_msg    String?   @db.Text
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  @@map("llm_provider_configs")
}

model Assessment {
  id               String           @id @default(cuid()) @db.VarChar(36)
  application_id   String           @db.VarChar(36)
  application      Application      @relation(fields: [application_id], references: [id], onDelete: Cascade)
  category         String           @default("Security") @db.VarChar(50)
  status           String           @default("queued") @db.VarChar(50) // queued, cloning, analyzing, completed, failed
  compliance_score Float?
  summary          String?          @db.Text
  items_count      Int              @default(0)
  meets_count      Int              @default(0)
  partial_count    Int              @default(0)
  fails_count      Int              @default(0)
  na_count         Int              @default(0)
  llm_provider     String?          @db.VarChar(50)
  llm_model        String?          @db.VarChar(100)
  error_message    String?          @db.Text
  started_at       DateTime?
  completed_at     DateTime?
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  items            AssessmentItem[]
  tasks            ReviewTask[]

  @@index([application_id])
  @@index([status])
  @@index([category])
  @@map("assessments")
}

model AssessmentItem {
  id             String     @id @default(cuid()) @db.VarChar(36)
  assessment_id  String     @db.VarChar(36)
  assessment     Assessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade)
  standard_id    String     @db.VarChar(100) // e.g. SEC-01
  title          String     @db.VarChar(255)
  category       String     @default("Security") @db.VarChar(50)
  result         String     @db.VarChar(50) // Meets, Partially Meets, Does Not Meet, Not Applicable
  severity       String     @default("Medium") @db.VarChar(50) // Critical, High, Medium, Low, Info
  evidence       String?    @db.Text
  recommendation String?    @db.Text
  created_at     DateTime   @default(now())
  tasks          ReviewTask[]

  @@index([assessment_id])
  @@index([result])
  @@map("assessment_items")
}

model WorkflowConfig {
  id                String   @id @default(cuid()) @db.VarChar(36)
  standard_id       String?  @db.VarChar(36)
  category          String   @default("Security") @db.VarChar(50)
  assigned_role     String   @default("security") @db.VarChar(50)
  auto_create_tasks Int      @default(1) @db.TinyInt
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@index([category])
  @@index([standard_id])
  @@map("workflow_configs")
}

model ReviewTask {
  id                  String          @id @default(cuid()) @db.VarChar(36)
  application_id      String          @db.VarChar(36)
  assessment_id       String          @db.VarChar(36)
  assessment_item_id  String          @db.VarChar(36)
  standard_id         String          @db.VarChar(100) // e.g. "SEC-03"
  standard_title      String          @db.VarChar(255)
  category            String          @default("Security") @db.VarChar(50)
  assigned_role       String          @default("security") @db.VarChar(50)
  assigned_to_user_id Int?
  status              String          @default("pending") @db.VarChar(50)
  // "pending", "approved", "rejected", "clarification_needed", "assigned_to_developer"
  severity            String          @default("Medium") @db.VarChar(50)
  resolution_notes    String?         @db.Text
  clarification_req   String?         @db.Text
  last_recheck_at     DateTime?
  recheck_count       Int             @default(0)
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt

  application         Application     @relation(fields: [application_id], references: [id], onDelete: Cascade)
  assessment          Assessment      @relation(fields: [assessment_id], references: [id], onDelete: Cascade)
  assessment_item     AssessmentItem  @relation(fields: [assessment_item_id], references: [id], onDelete: Cascade)
  assigned_user       User?           @relation("UserAssignedTasks", fields: [assigned_to_user_id], references: [id], onDelete: SetNull)
  activities          TaskActivity[]

  @@index([assigned_role, status])
  @@index([application_id])
  @@map("review_tasks")
}

model TaskActivity {
  id          String     @id @default(cuid()) @db.VarChar(36)
  task_id     String     @db.VarChar(36)
  user_id     Int?
  action      String     @db.VarChar(50) // "created", "status_change", "recheck_run", "comment"
  from_status String?    @db.VarChar(50)
  to_status   String?    @db.VarChar(50)
  comment     String?    @db.Text
  created_at  DateTime   @default(now())

  task        ReviewTask @relation(fields: [task_id], references: [id], onDelete: Cascade)
  user        User?      @relation("UserTaskActivities", fields: [user_id], references: [id], onDelete: SetNull)

  @@index([task_id])
  @@map("task_activities")
}

