// Jenkinsfile.dockerhub
//
// Builds the PixxelAI image and pushes it to Docker Hub under two tags:
//   - an auto-incremented "X.Y" version (1.0, 1.1, 1.2, ... queried from
//     Docker Hub itself, so no version state is kept in this repo or in Jenkins)
//   - "latest", always pointing at the same image as the newest version tag
//
// To wire this up: in the pixxelai-dockerhub Jenkins job, switch the pipeline
// definition from "Pipeline script" to "Pipeline script from SCM",
// pointing at this repo/branch with script path "Jenkinsfile.dockerhub".

pipeline {
    agent any

    environment {
        IMAGE_NAME = 'tlgrange/pixxelai'
        DOCKERHUB_CREDENTIALS_ID = 'DOCKERHUB_CREDENTIALS'
    }

    stages {
        stage('Setup: Docker') {
            steps {
                sh '''
                    if command -v docker >/dev/null 2>&1; then
                        echo "Docker already installed: $(docker --version)"
                    else
                        echo "Docker not found on this agent" >&2
                        exit 1
                    fi
                    sudo chmod 666 /var/run/docker.sock
                    docker --version
                '''
            }
        }

        stage('Setup: Buildx (multi-arch)') {
            steps {
                sh '''
                    # Registers QEMU emulators so this (amd64) agent can build
                    # an arm64 layer too, not just its native platform.
                    docker run --rm --privileged tonistiigi/binfmt --install all

                    docker buildx create --name pixxelai-builder --use || docker buildx use pixxelai-builder
                    docker buildx inspect --bootstrap
                '''
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify') {
            steps {
                sh '''
                    npm ci
                    npm run db:generate
                    npx tsc --noEmit
                    npm test
                '''
            }
        }

        stage('Compute Version') {
            steps {
                script {
                    def response = sh(
                        script: "curl -sf 'https://hub.docker.com/v2/repositories/${env.IMAGE_NAME}/tags?page_size=100' || echo ''",
                        returnStdout: true
                    ).trim()

                    if (!response) {
                        echo "No tags found or repository is new on Docker Hub. Defaulting to 1.0"
                        env.IMAGE_VERSION = "1.0"
                    } else {
                        env.IMAGE_VERSION = computeNextVersion(response)
                    }
                    echo "Computed next version: ${env.IMAGE_VERSION}"
                }
            }
        }

        stage('Build & Push (multi-arch)') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: DOCKERHUB_CREDENTIALS_ID,
                    usernameVariable: 'DOCKERHUB_USER',
                    passwordVariable: 'DOCKERHUB_PASS'
                )]) {
                    sh '''
                        echo "$DOCKERHUB_PASS" | docker login -u "$DOCKERHUB_USER" --password-stdin
                        docker buildx build \
                            --platform linux/amd64,linux/arm64 \
                            --build-arg NPM_REGISTRY=http://192.168.100.223:4873 \
                            -t ${IMAGE_NAME}:${IMAGE_VERSION} \
                            -t ${IMAGE_NAME}:latest \
                            --push .
                        docker logout
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                if (env.IMAGE_VERSION) {
                    sh "docker rmi ${IMAGE_NAME}:${IMAGE_VERSION} ${IMAGE_NAME}:latest || true"
                }
            }
            cleanWs()
        }
        success {
            echo "Pushed ${IMAGE_NAME}:${IMAGE_VERSION} and ${IMAGE_NAME}:latest"
        }
        failure {
            echo "Build/push failed -- check logs above"
        }
    }
}

@NonCPS
def computeNextVersion(String tagsJson) {
    def matches = (tagsJson =~ /"name"\s*:\s*"(\d+)\.(\d+)"/)
    def versions = []
    for (m in matches) {
        versions << [m[1].toInteger(), m[2].toInteger()]
    }

    if (versions.isEmpty()) {
        return "1.0"
    }

    versions.sort { a, b -> a[0] != b[0] ? a[0] <=> b[0] : a[1] <=> b[1] }
    def latest = versions[-1]
    return "${latest[0]}.${latest[1] + 1}"
}
